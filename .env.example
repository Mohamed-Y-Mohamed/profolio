# Mailjet — Send API v3.1 (https://app.mailjet.com/account/apikeys)
# Set these in Netlify > Site configuration > Environment variables.
# Never commit real values: .env* is gitignored.

MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Numeric ID of the template in Mailjet > Transactional > Templates
MAILJET_TEMPLATE_ID=

# Must be a sender/domain validated in Mailjet. Use an address on your own
# domain — sending "from" an outlook.com address fails DMARC and lands in spam.
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Portfolio

# Where contact messages are delivered
CONTACT_TO_EMAIL=mohamed.y.mohamed1@outlook.com
CONTACT_TO_NAME=Mohamed Yusuf Mohamed
